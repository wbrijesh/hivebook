# Single source of LOCAL secret values for the whole Hivebook dev stack.
# Copy to infra/.env (gitignored) and fill in the values:  cp infra/.env.example infra/.env
# The deploy recipes (`just install` / auth / api / observability) inject these
# into the cluster — secret values live ONLY here, never in committed manifests.
HIVEBOOK_DB_PASSWORD=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
