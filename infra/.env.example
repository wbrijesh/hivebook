# Single source of LOCAL secret values for the whole Hivebook dev stack.
# Copy to infra/.env (gitignored) and fill in the values:  cp infra/.env.example infra/.env
# The deploy recipes (`just install` / auth / api / observability) inject these
# into the cluster — secret values live ONLY here, never in committed manifests.
HIVEBOOK_DB_PASSWORD=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Connector OAuth app credentials. Fill these in to enable "Connect" for a source;
# leave blank and that connector's connect flow stays disabled. Register each OAuth
# app with redirect URI https://api.hivebook.localhost/connectors/<id>/callback
# (github, gdocs). Re-run `just update integrations` after changing these.
HIVEBOOK_GITHUB_CLIENT_ID=
HIVEBOOK_GITHUB_CLIENT_SECRET=
HIVEBOOK_GDOCS_CLIENT_ID=
HIVEBOOK_GDOCS_CLIENT_SECRET=