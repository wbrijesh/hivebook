{
  "title": "Integrations / Metrics",
  "uid": "hivebook-integrations-metrics",
  "tags": [
    "hivebook",
    "integrations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sync jobs by state (queue depth)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hivebook_sync_jobs) by (state)",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sync runs (per s by result)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hivebook_sync_runs_total[$__rate_interval])) by (result)",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sync duration p50 / p90 / p99 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(hivebook_sync_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum(rate(hivebook_sync_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(hivebook_sync_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Artifacts ingested (per s by connector)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hivebook_artifacts_ingested_total[$__rate_interval])) by (connector)",
          "legendFormat": "{{connector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token refresh (per s by result)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hivebook_token_refresh_total[$__rate_interval])) by (result)",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Source rate-limits (per s by connector)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hivebook_source_rate_limited_total[$__rate_interval])) by (connector)",
          "legendFormat": "{{connector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connector cap hits (per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hivebook_connector_cap_hits_total[$__rate_interval])) by (connector, kind)",
          "legendFormat": "{{connector}}/{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Worker replicas (KEDA scale 0→N)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas{namespace=\"hivebook\", deployment=\"integrations-worker\"}",
          "legendFormat": "running",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    }
  ]
}
