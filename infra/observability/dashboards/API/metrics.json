{
  "title": "API / Metrics",
  "uid": "trenches-api-metrics",
  "tags": [
    "trenches",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s by route)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trenches_http_requests_total[$__rate_interval])) by (route)",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors (4xx / 5xx per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trenches_http_requests_total{code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(trenches_http_requests_total{code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p90 / p99 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(trenches_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum(rate(trenches_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(trenches_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "In-flight",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trenches_http_requests_in_flight",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Auth verifications (by result)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trenches_auth_verifications_total[$__rate_interval])) by (result)",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB connection pool",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trenches_db_open_connections",
          "legendFormat": "open",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "B",
          "expr": "trenches_db_in_use_connections",
          "legendFormat": "in use",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "C",
          "expr": "trenches_db_idle_connections",
          "legendFormat": "idle",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "D",
          "expr": "trenches_db_max_open_connections",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    }
  ]
}