{
  "title": "Frontend / Metrics",
  "uid": "trenches-fe-metrics",
  "tags": [
    "trenches",
    "frontend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Browser telemetry from the web app's beacon (POST /events -> trenches_web_events_total).",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Web events (per s by type)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trenches_web_events_total[$__rate_interval])) by (type)",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Page views (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trenches_web_events_total{type=\"page_view\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Logins (success / error)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trenches_web_events_total{type=\"login_success\"})",
          "legendFormat": "success",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(trenches_web_events_total{type=\"login_error\"})",
          "legendFormat": "error",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cumulative events by type",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trenches_web_events_total) by (type)",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    }
  ]
}