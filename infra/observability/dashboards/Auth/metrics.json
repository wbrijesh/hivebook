{
  "title": "Auth / Metrics",
  "uid": "hivebook-auth-metrics",
  "tags": [
    "hivebook",
    "auth"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "ZITADEL from /debug/metrics (job=zitadel) + the API's token-verification outcomes.",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Token verifications (API side, by result)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hivebook_auth_verifications_total[$__rate_interval])) by (result)",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ZITADEL gRPC errors (non-200)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(grpc_server_grpc_status_code_total{job=\"zitadel\",return_code!=\"200\"}[$__rate_interval])) by (return_code)",
          "legendFormat": "{{return_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ZITADEL gRPC rate (by method)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(grpc_server_grpc_status_code_total{job=\"zitadel\"}[$__rate_interval])) by (grpc_method)",
          "legendFormat": "{{grpc_method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ZITADEL goroutines / memory",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=~\"zitadel.*\"}",
          "legendFormat": "goroutines",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes{job=~\"zitadel.*\"}",
          "legendFormat": "rss bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          }
        }
      ]
    }
  ]
}