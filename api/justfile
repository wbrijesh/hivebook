# api — Go service tasks. Run `just` for the list.

set shell := ["bash", "-c"]

# Show commands
[private]
default:
    @just --list

# Build + test
all: build test

# Build the binary
build:
    @echo "Building..."
    go build -o main cmd/api/main.go

# Run the app
run:
    go run cmd/api/main.go

# Run all tests (verbose)
test:
    @echo "Testing..."
    go test ./... -v

# Integration tests (database)
itest:
    @echo "Running integration tests..."
    go test ./internal/database -v

# Start the DB container (docker compose, with V1 fallback)
docker-run:
    @docker compose up --build 2>/dev/null || { echo "Falling back to Docker Compose V1"; docker-compose up --build; }

# Stop the DB container
docker-down:
    @docker compose down 2>/dev/null || { echo "Falling back to Docker Compose V1"; docker-compose down; }

# Remove the binary
clean:
    @echo "Cleaning..."
    rm -f main

# Live reload (installs air if missing)
watch:
    #!/usr/bin/env bash
    if command -v air >/dev/null; then
      air
    else
      read -p "Go's 'air' is not installed on your machine. Do you want to install it? [Y/n] " choice
      if [ "$choice" != "n" ] && [ "$choice" != "N" ]; then
        go install github.com/air-verse/air@latest && air
      else
        echo "You chose not to install air. Exiting..."; exit 1
      fi
    fi
